# Server
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@host:5432/weathersphere

# Redis
REDIS_URL=redis://:password@host:6379

# JWT
JWT_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-a-different-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=WeatherSphere

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://weathersphere-api.onrender.com/api/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@weathersphere.com

# Weather APIs
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://weathersphere.vercel.app

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Swagger
SWAGGER_ENABLED=false
SWAGGER_PATH=/api/docs

# Encryption
ENCRYPTION_KEY=generate-a-32-char-encryption-key
